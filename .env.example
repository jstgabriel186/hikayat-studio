# ============================================================
# Hikayat Studio — konfigurasi lokal (CONTOH)
# ------------------------------------------------------------
# CARA PAKAI:
#   1) Salin jadi `.env`           → isi DATABASE_URL (dibaca Prisma CLI + Next)
#   2) Salin jadi `.env.local`     → isi API key & pilihan AI (khusus Next.js)
# Keduanya tidak boleh di-commit (sudah di .gitignore).
# ============================================================

# --- Database ---
# Lokal (default): SQLite, berkas dibuat di ./prisma/dev.db
# PostgreSQL: ganti jadi
#   DATABASE_URL="postgresql://user:pass@localhost:5432/hikayat?schema=public"
#   lalu ubah `provider = "sqlite"` di prisma/schema.prisma menjadi "postgresql"
#   dan jalankan: npm run db:migrate
DATABASE_URL="file:./dev.db"

# --- AI Provider -------------------------------------------------
# Urutan otomatis (AI_PROVIDER="auto"): Anthropic → Gemini → Mode Uji
#   (tergantung kunci mana yang terisi).
#
# 💡 GRATIS & tanpa modal:
#   - Isi GEMINI_API_KEY (kunci gratis dari https://aistudio.google.com/apikey,
#     tanpa kartu kredit; model default gemini-2.5-flash termasuk free tier)
#   - atau biarkan kosong → aplikasi otomatis memakai Mode Uji (tanpa AI nyata).
#
# AI_PROVIDER  = "auto"      (default)
#              = "anthropic" | "gemini" | "mock"
AI_PROVIDER="auto"

# Model LLM per provider (bisa diganti juga lewat UI opsi "Lanjutan")
ANTHROPIC_MODEL="claude-sonnet-4-5"
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_MODEL="gpt-4o"
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# API keys — JANGAN commit key asli. Isi di `.env.local` milikmu sendiri.
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
